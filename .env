# Vite env vars. Vars prefixed VITE_* are inlined into the client bundle
# at build time. Override per-environment by setting them in deploy scripts
# or in .env.development (loaded only by `bun dev`).

# Hides the Intro / presentation route. Flip to true when the section is
# polished and ready to ship. See package.json deploy:dev script — the
# preview deploy keeps it on so the intro can be tested in a real browser
# while production stays clean.
VITE_INTRO_ENABLED=false
